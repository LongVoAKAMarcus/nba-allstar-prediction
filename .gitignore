# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDE and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Large raw datasets & models (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
models/*
!models/.gitkeep

# Allow processed data and prediction reports for team collaboration
!data/processed/*.csv
!reports/predictions.csv

# Output CSVs / temporary dumps
*.csv
!data/processed/*.csv
!reports/predictions.csv
!sample_data/*.csv
reports/*.pdf
reports/*.html

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
